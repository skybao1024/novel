      "fragment_ordinal": 7,
      "quote_hash": "ad4fecb8d00cf0b6544e288afabd844f956f5c0eecb0a83a2ee92e4370052443",
      "excerpt": "雨声里，沈砚摘下旧银戒：我本名萧砚，是先王遗子。"
    },
    {
      "schema_version": "1.0.0",
      "source_ref_id": "30000000-0000-4000-8000-000000000002",
      "document_id": "20000000-0000-4000-8000-000000000001",
