{
  "$defs": {
    "BootstrapEntityDraft": {
      "additionalProperties": false,
      "properties": {
        "display_name": {
          "minLength": 1,
          "title": "Display Name",
          "type": "string"
        },
        "entity_type": {
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_-]*$",
          "title": "Entity Type",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "temporary_name": {
          "minLength": 1,
          "title": "Temporary Name",
          "type": "string"
        }
      },
      "required": [
        "temporary_name",
        "entity_type",
        "display_name"
      ],
      "title": "BootstrapEntityDraft",
      "type": "object"
    },
    "IntentContent": {
      "additionalProperties": false,
      "description": "The four authoritative, reviewable Intent Canon documents.",
      "properties": {
        "creative_brief": {
          "minLength": 1,
          "title": "Creative Brief",
          "type": "string"
        },
        "current_outline": {
          "minLength": 1,
          "title": "Current Outline",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "story_bible": {
          "minLength": 1,
          "title": "Story Bible",
          "type": "string"
        },
        "writing_rules": {
          "minLength": 1,
          "title": "Writing Rules",
          "type": "string"
        }
      },
      "required": [
        "creative_brief",
        "story_bible",
        "writing_rules",
        "current_outline"
      ],
      "title": "IntentContent",
      "type": "object"
    }
  },
  "$id": "https://novel.local/schemas/bootstrap-draft.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "entity_drafts": {
      "default": [],
      "items": {
        "$ref": "#/$defs/BootstrapEntityDraft"
      },
      "title": "Entity Drafts",
      "type": "array"
    },
    "initial_goal": {
      "minLength": 1,
      "title": "Initial Goal",
      "type": "string"
    },
    "intent": {
      "$ref": "#/$defs/IntentContent"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "unresolved_questions": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 64,
      "title": "Unresolved Questions",
      "type": "array"
    }
  },
  "required": [
    "intent",
    "initial_goal"
  ],
  "title": "BootstrapDraft",
  "type": "object",
  "x-schema-version": "1.0.0"
}
