{
  "$defs": {
    "EventCanonStatus": {
      "enum": [
        "candidate",
        "approved",
        "superseded"
      ],
      "title": "EventCanonStatus",
      "type": "string"
    },
    "StoryTime": {
      "additionalProperties": false,
      "description": "A calendar-neutral position on a story timeline.\n\nNarrative order deliberately does not belong to this value object. It is a\nproperty of the chapter or event through which readers encounter the event.",
      "properties": {
        "display_time": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Time"
        },
        "kind": {
          "$ref": "#/$defs/StoryTimeKind"
        },
        "relative_offset": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Relative Offset"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "story_time_end": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Story Time End"
        },
        "story_time_start": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Story Time Start"
        },
        "time_anchor_event_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Time Anchor Event Id"
        },
        "timeline_id": {
          "default": "main",
          "minLength": 1,
          "title": "Timeline Id",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "StoryTime",
      "type": "object"
    },
    "StoryTimeKind": {
      "enum": [
        "exact",
        "ordinal",
        "relative",
        "interval",
        "unknown"
      ],
      "title": "StoryTimeKind",
      "type": "string"
    }
  },
  "$id": "https://novel.local/schemas/event.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A story-world occurrence and the order in which readers encounter it.",
  "properties": {
    "canon_status": {
      "$ref": "#/$defs/EventCanonStatus",
      "default": "approved"
    },
    "event_id": {
      "format": "uuid",
      "title": "Event Id",
      "type": "string"
    },
    "event_type": {
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_.-]*$",
      "title": "Event Type",
      "type": "string"
    },
    "location_entity_ids": {
      "default": [],
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Location Entity Ids",
      "type": "array"
    },
    "narrative_order": {
      "minimum": 1,
      "title": "Narrative Order",
      "type": "integer"
    },
    "participant_entity_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "minItems": 1,
      "title": "Participant Entity Ids",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_chapter_id": {
      "format": "uuid",
      "title": "Source Chapter Id",
      "type": "string"
    },
    "source_ref_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "minItems": 1,
      "title": "Source Ref Ids",
      "type": "array"
    },
    "story_time": {
      "$ref": "#/$defs/StoryTime"
    },
    "summary": {
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "event_type",
    "story_time",
    "narrative_order",
    "participant_entity_ids",
    "source_chapter_id",
    "source_ref_ids",
    "summary"
  ],
  "title": "Event",
  "type": "object",
  "x-schema-version": "1.0.0"
}
