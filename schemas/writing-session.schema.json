{
  "$defs": {
    "StoryTime": {
      "additionalProperties": false,
      "description": "A calendar-neutral position on a story timeline.\n\nNarrative order deliberately does not belong to this value object. It is a\nproperty of the chapter or event through which readers encounter the event.",
      "properties": {
        "display_time": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Time"
        },
        "kind": {
          "$ref": "#/$defs/StoryTimeKind"
        },
        "relative_offset": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Relative Offset"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "story_time_end": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Story Time End"
        },
        "story_time_start": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Story Time Start"
        },
        "time_anchor_event_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Time Anchor Event Id"
        },
        "timeline_id": {
          "default": "main",
          "minLength": 1,
          "title": "Timeline Id",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "StoryTime",
      "type": "object"
    },
    "StoryTimeKind": {
      "enum": [
        "exact",
        "ordinal",
        "relative",
        "interval",
        "unknown"
      ],
      "title": "StoryTimeKind",
      "type": "string"
    },
    "WritingSessionMode": {
      "enum": [
        "create",
        "revise"
      ],
      "title": "WritingSessionMode",
      "type": "string"
    },
    "WritingSessionStatus": {
      "enum": [
        "open",
        "closed"
      ],
      "title": "WritingSessionStatus",
      "type": "string"
    }
  },
  "$id": "https://novel.local/schemas/writing-session.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "after_chapter_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "After Chapter Id"
    },
    "author_goal": {
      "minLength": 1,
      "title": "Author Goal",
      "type": "string"
    },
    "base_canon_revision": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Base Canon Revision",
      "type": "string"
    },
    "base_document_revision": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Base Document Revision"
    },
    "base_intent_revision": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Base Intent Revision",
      "type": "string"
    },
    "before_chapter_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Before Chapter Id"
    },
    "closed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Closed At"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "creative_constraints": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 64,
      "title": "Creative Constraints",
      "type": "array"
    },
    "location_entity_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Location Entity Id"
    },
    "mode": {
      "$ref": "#/$defs/WritingSessionMode",
      "default": "create"
    },
    "pov_entity_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pov Entity Id"
    },
    "project_id": {
      "format": "uuid",
      "title": "Project Id",
      "type": "string"
    },
    "required_chapter_heading": {
      "minLength": 1,
      "title": "Required Chapter Heading",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/WritingSessionStatus"
    },
    "target_chapter_id": {
      "format": "uuid",
      "title": "Target Chapter Id",
      "type": "string"
    },
    "target_chapter_number": {
      "minimum": 1,
      "title": "Target Chapter Number",
      "type": "integer"
    },
    "target_chapter_title": {
      "minLength": 1,
      "title": "Target Chapter Title",
      "type": "string"
    },
    "target_document_id": {
      "format": "uuid",
      "title": "Target Document Id",
      "type": "string"
    },
    "target_document_path": {
      "minLength": 1,
      "title": "Target Document Path",
      "type": "string"
    },
    "target_narrative_order": {
      "minimum": 1,
      "title": "Target Narrative Order",
      "type": "integer"
    },
    "target_story_time": {
      "$ref": "#/$defs/StoryTime"
    },
    "target_volume_id": {
      "format": "uuid",
      "title": "Target Volume Id",
      "type": "string"
    },
    "target_volume_number": {
      "minimum": 1,
      "title": "Target Volume Number",
      "type": "integer"
    },
    "target_volume_title": {
      "minLength": 1,
      "title": "Target Volume Title",
      "type": "string"
    },
    "writing_session_id": {
      "format": "uuid",
      "title": "Writing Session Id",
      "type": "string"
    }
  },
  "required": [
    "writing_session_id",
    "project_id",
    "target_chapter_id",
    "target_document_id",
    "target_document_path",
    "target_chapter_number",
    "target_chapter_title",
    "target_volume_id",
    "target_volume_number",
    "target_volume_title",
    "required_chapter_heading",
    "target_narrative_order",
    "target_story_time",
    "base_canon_revision",
    "base_intent_revision",
    "author_goal",
    "status",
    "created_at"
  ],
  "title": "WritingSession",
  "type": "object",
  "x-schema-version": "1.0.0"
}
