{
  "$defs": {
    "Event": {
      "additionalProperties": false,
      "description": "A story-world occurrence and the order in which readers encounter it.",
      "properties": {
        "canon_status": {
          "$ref": "#/$defs/EventCanonStatus",
          "default": "approved"
        },
        "event_id": {
          "format": "uuid",
          "title": "Event Id",
          "type": "string"
        },
        "event_type": {
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "title": "Event Type",
          "type": "string"
        },
        "location_entity_ids": {
          "default": [],
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Location Entity Ids",
          "type": "array"
        },
        "narrative_order": {
          "minimum": 1,
          "title": "Narrative Order",
          "type": "integer"
        },
        "participant_entity_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "minItems": 1,
          "title": "Participant Entity Ids",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_ref_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Ref Ids",
          "type": "array"
        },
        "source_scene_id": {
          "format": "uuid",
          "title": "Source Scene Id",
          "type": "string"
        },
        "story_time": {
          "$ref": "#/$defs/StoryTime"
        },
        "summary": {
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "event_id",
        "event_type",
        "story_time",
        "narrative_order",
        "participant_entity_ids",
        "source_scene_id",
        "source_ref_ids",
        "summary"
      ],
      "title": "Event",
      "type": "object"
    },
    "EventCanonStatus": {
      "enum": [
        "candidate",
        "approved",
        "superseded"
      ],
      "title": "EventCanonStatus",
      "type": "string"
    },
    "EventChainDirection": {
      "enum": [
        "incoming",
        "outgoing",
        "both"
      ],
      "title": "EventChainDirection",
      "type": "string"
    },
    "EventEdge": {
      "additionalProperties": false,
      "description": "A directed semantic relation between two distinct events.",
      "properties": {
        "edge_type": {
          "$ref": "#/$defs/EventEdgeType"
        },
        "event_edge_id": {
          "format": "uuid",
          "title": "Event Edge Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_event_id": {
          "format": "uuid",
          "title": "Source Event Id",
          "type": "string"
        },
        "source_ref_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Ref Id"
        },
        "target_event_id": {
          "format": "uuid",
          "title": "Target Event Id",
          "type": "string"
        }
      },
      "required": [
        "event_edge_id",
        "source_event_id",
        "target_event_id",
        "edge_type"
      ],
      "title": "EventEdge",
      "type": "object"
    },
    "EventEdgeType": {
      "enum": [
        "causes",
        "enables",
        "prevents",
        "reveals",
        "foreshadows",
        "pays_off",
        "contradicts"
      ],
      "title": "EventEdgeType",
      "type": "string"
    },
    "QueryWarning": {
      "additionalProperties": false,
      "description": "A mechanical limitation that keeps a query result from being definitive.",
      "properties": {
        "code": {
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Code",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "related_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Related Ids",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "QueryWarning",
      "type": "object"
    },
    "SourceRef": {
      "additionalProperties": false,
      "description": "A revision-aware source pointer that survives ordinary text movement.",
      "properties": {
        "document_id": {
          "format": "uuid",
          "title": "Document Id",
          "type": "string"
        },
        "document_revision": {
          "minLength": 1,
          "title": "Document Revision",
          "type": "string"
        },
        "excerpt": {
          "minLength": 1,
          "title": "Excerpt",
          "type": "string"
        },
        "fragment_ordinal": {
          "minimum": 1,
          "title": "Fragment Ordinal",
          "type": "integer"
        },
        "quote_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Quote Hash",
          "type": "string"
        },
        "scene_id": {
          "format": "uuid",
          "title": "Scene Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_ref_id": {
          "format": "uuid",
          "title": "Source Ref Id",
          "type": "string"
        }
      },
      "required": [
        "source_ref_id",
        "document_id",
        "scene_id",
        "document_revision",
        "fragment_ordinal",
        "quote_hash",
        "excerpt"
      ],
      "title": "SourceRef",
      "type": "object"
    },
    "StoryTime": {
      "additionalProperties": false,
      "description": "A calendar-neutral position on a story timeline.\n\nNarrative order deliberately does not belong to this value object. It is a\nproperty of the scene or event through which readers encounter the event.",
      "properties": {
        "display_time": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Time"
        },
        "kind": {
          "$ref": "#/$defs/StoryTimeKind"
        },
        "relative_offset": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Relative Offset"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "story_time_end": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Story Time End"
        },
        "story_time_start": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Story Time Start"
        },
        "time_anchor_event_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Time Anchor Event Id"
        },
        "timeline_id": {
          "default": "main",
          "minLength": 1,
          "title": "Timeline Id",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "StoryTime",
      "type": "object"
    },
    "StoryTimeKind": {
      "enum": [
        "exact",
        "ordinal",
        "relative",
        "interval",
        "unknown"
      ],
      "title": "StoryTimeKind",
      "type": "string"
    }
  },
  "$id": "https://novel.local/schemas/event-chain.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A chain over sparse approved Events, not a complete causal graph.",
  "properties": {
    "direction": {
      "$ref": "#/$defs/EventChainDirection"
    },
    "edges": {
      "items": {
        "$ref": "#/$defs/EventEdge"
      },
      "title": "Edges",
      "type": "array"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/Event"
      },
      "title": "Events",
      "type": "array"
    },
    "max_depth": {
      "maximum": 20,
      "minimum": 0,
      "title": "Max Depth",
      "type": "integer"
    },
    "root_event_id": {
      "format": "uuid",
      "title": "Root Event Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_refs": {
      "items": {
        "$ref": "#/$defs/SourceRef"
      },
      "title": "Source Refs",
      "type": "array"
    },
    "warnings": {
      "default": [],
      "items": {
        "$ref": "#/$defs/QueryWarning"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "root_event_id",
    "direction",
    "max_depth",
    "events",
    "edges",
    "source_refs"
  ],
  "title": "EventChain",
  "type": "object",
  "x-schema-version": "1.0.0"
}
