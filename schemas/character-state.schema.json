{
  "$defs": {
    "Assertion": {
      "additionalProperties": false,
      "description": "A scope's time-bounded stance toward a Proposition.",
      "properties": {
        "assertion_id": {
          "format": "uuid",
          "title": "Assertion Id",
          "type": "string"
        },
        "certainty": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Certainty",
          "type": "number"
        },
        "change_set_id": {
          "format": "uuid",
          "title": "Change Set Id",
          "type": "string"
        },
        "holder_entity_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Holder Entity Id"
        },
        "proposition_id": {
          "format": "uuid",
          "title": "Proposition Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/AssertionScope"
        },
        "source_ref_id": {
          "format": "uuid",
          "title": "Source Ref Id",
          "type": "string"
        },
        "stance": {
          "$ref": "#/$defs/AssertionStance"
        },
        "valid_from": {
          "$ref": "#/$defs/StoryTime"
        },
        "valid_to": {
          "anyOf": [
            {
              "$ref": "#/$defs/StoryTime"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "assertion_id",
        "proposition_id",
        "scope",
        "stance",
        "certainty",
        "valid_from",
        "source_ref_id",
        "change_set_id"
      ],
      "title": "Assertion",
      "type": "object"
    },
    "AssertionScope": {
      "enum": [
        "objective",
        "character",
        "reader",
        "narrator"
      ],
      "title": "AssertionScope",
      "type": "string"
    },
    "AssertionStance": {
      "enum": [
        "true",
        "false",
        "unknown",
        "suspected",
        "claimed",
        "disbelieved"
      ],
      "title": "AssertionStance",
      "type": "string"
    },
    "CharacterStatePhase": {
      "enum": [
        "entry",
        "exit"
      ],
      "title": "CharacterStatePhase",
      "type": "string"
    },
    "ObjectKind": {
      "enum": [
        "entity",
        "value"
      ],
      "title": "ObjectKind",
      "type": "string"
    },
    "Proposition": {
      "additionalProperties": false,
      "description": "A claim-shaped statement that intentionally carries no truth value.",
      "properties": {
        "object_entity_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Object Entity Id"
        },
        "object_kind": {
          "$ref": "#/$defs/ObjectKind"
        },
        "object_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Object Value"
        },
        "predicate": {
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "title": "Predicate",
          "type": "string"
        },
        "proposition_id": {
          "format": "uuid",
          "title": "Proposition Id",
          "type": "string"
        },
        "qualifiers_json": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Qualifier"
          },
          "title": "Qualifiers Json",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "subject_entity_id": {
          "format": "uuid",
          "title": "Subject Entity Id",
          "type": "string"
        }
      },
      "required": [
        "proposition_id",
        "subject_entity_id",
        "predicate",
        "object_kind"
      ],
      "title": "Proposition",
      "type": "object"
    },
    "Qualifier": {
      "additionalProperties": false,
      "description": "An immutable scalar qualifier attached to a proposition.",
      "properties": {
        "key": {
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "key",
        "value"
      ],
      "title": "Qualifier",
      "type": "object"
    },
    "QueryWarning": {
      "additionalProperties": false,
      "description": "A mechanical limitation that keeps a query result from being definitive.",
      "properties": {
        "code": {
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Code",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "related_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Related Ids",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "QueryWarning",
      "type": "object"
    },
    "SourceRef": {
      "additionalProperties": false,
      "description": "A revision-aware source pointer that survives ordinary text movement.",
      "properties": {
        "document_id": {
          "format": "uuid",
          "title": "Document Id",
          "type": "string"
        },
        "document_revision": {
          "minLength": 1,
          "title": "Document Revision",
          "type": "string"
        },
        "excerpt": {
          "minLength": 1,
          "title": "Excerpt",
          "type": "string"
        },
        "fragment_ordinal": {
          "minimum": 1,
          "title": "Fragment Ordinal",
          "type": "integer"
        },
        "quote_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Quote Hash",
          "type": "string"
        },
        "scene_id": {
          "format": "uuid",
          "title": "Scene Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_ref_id": {
          "format": "uuid",
          "title": "Source Ref Id",
          "type": "string"
        }
      },
      "required": [
        "source_ref_id",
        "document_id",
        "scene_id",
        "document_revision",
        "fragment_ordinal",
        "quote_hash",
        "excerpt"
      ],
      "title": "SourceRef",
      "type": "object"
    },
    "SourcedAssertion": {
      "additionalProperties": false,
      "description": "One approved Assertion with the Proposition and exact SourceRef it names.",
      "properties": {
        "assertion": {
          "$ref": "#/$defs/Assertion"
        },
        "proposition": {
          "$ref": "#/$defs/Proposition"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_ref": {
          "$ref": "#/$defs/SourceRef"
        }
      },
      "required": [
        "assertion",
        "proposition",
        "source_ref"
      ],
      "title": "SourcedAssertion",
      "type": "object"
    },
    "StoryTime": {
      "additionalProperties": false,
      "description": "A calendar-neutral position on a story timeline.\n\nNarrative order deliberately does not belong to this value object. It is a\nproperty of the scene or event through which readers encounter the event.",
      "properties": {
        "display_time": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Time"
        },
        "kind": {
          "$ref": "#/$defs/StoryTimeKind"
        },
        "relative_offset": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Relative Offset"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "story_time_end": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Story Time End"
        },
        "story_time_start": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Story Time Start"
        },
        "time_anchor_event_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Time Anchor Event Id"
        },
        "timeline_id": {
          "default": "main",
          "minLength": 1,
          "title": "Timeline Id",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "StoryTime",
      "type": "object"
    },
    "StoryTimeKind": {
      "enum": [
        "exact",
        "ordinal",
        "relative",
        "interval",
        "unknown"
      ],
      "title": "StoryTimeKind",
      "type": "string"
    }
  },
  "$id": "https://novel.local/schemas/character-state.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A sparse Canon view, never a claim that prose contains no other state.",
  "properties": {
    "active_goals": {
      "default": [],
      "items": {
        "$ref": "#/$defs/SourcedAssertion"
      },
      "title": "Active Goals",
      "type": "array"
    },
    "character_id": {
      "format": "uuid",
      "title": "Character Id",
      "type": "string"
    },
    "knowledge_and_beliefs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/SourcedAssertion"
      },
      "title": "Knowledge And Beliefs",
      "type": "array"
    },
    "location": {
      "anyOf": [
        {
          "$ref": "#/$defs/SourcedAssertion"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "objective_state": {
      "default": [],
      "items": {
        "$ref": "#/$defs/SourcedAssertion"
      },
      "title": "Objective State",
      "type": "array"
    },
    "phase": {
      "$ref": "#/$defs/CharacterStatePhase"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "story_time": {
      "$ref": "#/$defs/StoryTime"
    },
    "target_scene_id": {
      "format": "uuid",
      "title": "Target Scene Id",
      "type": "string"
    },
    "warnings": {
      "default": [],
      "items": {
        "$ref": "#/$defs/QueryWarning"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "character_id",
    "target_scene_id",
    "phase",
    "story_time"
  ],
  "title": "CharacterState",
  "type": "object",
  "x-schema-version": "1.0.0"
}
