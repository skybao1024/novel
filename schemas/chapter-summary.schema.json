{
  "$defs": {
    "SceneSummaryDependency": {
      "additionalProperties": false,
      "description": "The exact Scene Summary revision consumed by a Chapter Summary.",
      "properties": {
        "scene_id": {
          "format": "uuid",
          "title": "Scene Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_revision": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Source Revision",
          "type": "string"
        },
        "summary_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Summary Digest",
          "type": "string"
        }
      },
      "required": [
        "scene_id",
        "source_revision",
        "summary_digest"
      ],
      "title": "SceneSummaryDependency",
      "type": "object"
    }
  },
  "$id": "https://novel.local/schemas/chapter-summary.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Non-Canon aggregation over one Chapter's Scene Summaries.",
  "properties": {
    "chapter_id": {
      "format": "uuid",
      "title": "Chapter Id",
      "type": "string"
    },
    "chapter_number": {
      "minimum": 1,
      "title": "Chapter Number",
      "type": "integer"
    },
    "main_entity_ids": {
      "default": [],
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "maxItems": 32,
      "title": "Main Entity Ids",
      "type": "array"
    },
    "scene_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "minItems": 1,
      "title": "Scene Ids",
      "type": "array"
    },
    "scene_summary_dependencies": {
      "items": {
        "$ref": "#/$defs/SceneSummaryDependency"
      },
      "minItems": 1,
      "title": "Scene Summary Dependencies",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "summary": {
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "chapter_id",
    "chapter_number",
    "title",
    "scene_ids",
    "scene_summary_dependencies",
    "summary"
  ],
  "title": "ChapterSummary",
  "type": "object",
  "x-schema-version": "1.0.0"
}
