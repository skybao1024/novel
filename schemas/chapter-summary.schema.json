{
  "$id": "https://novel.local/schemas/chapter-summary.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Non-Canon navigation memory for one approved Chapter revision.",
  "properties": {
    "chapter_id": {
      "format": "uuid",
      "title": "Chapter Id",
      "type": "string"
    },
    "chapter_number_in_volume": {
      "minimum": 1,
      "title": "Chapter Number In Volume",
      "type": "integer"
    },
    "key_changes": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 32,
      "title": "Key Changes",
      "type": "array"
    },
    "main_entity_ids": {
      "default": [],
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "maxItems": 32,
      "title": "Main Entity Ids",
      "type": "array"
    },
    "open_questions": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 32,
      "title": "Open Questions",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_document_id": {
      "format": "uuid",
      "title": "Source Document Id",
      "type": "string"
    },
    "source_revision": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Source Revision",
      "type": "string"
    },
    "summary": {
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    },
    "volume_id": {
      "format": "uuid",
      "title": "Volume Id",
      "type": "string"
    }
  },
  "required": [
    "chapter_id",
    "volume_id",
    "chapter_number_in_volume",
    "source_document_id",
    "source_revision",
    "summary"
  ],
  "title": "ChapterSummary",
  "type": "object",
  "x-schema-version": "1.0.0"
}
