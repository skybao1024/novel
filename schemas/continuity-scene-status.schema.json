{
  "$id": "https://novel.local/schemas/continuity-scene-status.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "chapter_id": {
      "format": "uuid",
      "title": "Chapter Id",
      "type": "string"
    },
    "document_id": {
      "format": "uuid",
      "title": "Document Id",
      "type": "string"
    },
    "document_revision": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Document Revision",
      "type": "string"
    },
    "narrative_order": {
      "minimum": 1,
      "title": "Narrative Order",
      "type": "integer"
    },
    "retrieved_source_ids": {
      "default": [],
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Retrieved Source Ids",
      "type": "array"
    },
    "satisfied": {
      "title": "Satisfied",
      "type": "boolean"
    },
    "scene_id": {
      "format": "uuid",
      "title": "Scene Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "chapter_id",
    "scene_id",
    "document_id",
    "document_revision",
    "narrative_order",
    "satisfied"
  ],
  "title": "ContinuitySceneStatus",
  "type": "object",
  "x-schema-version": "1.0.0"
}
