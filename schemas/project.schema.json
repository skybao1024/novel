{
  "$defs": {
    "ProjectStatus": {
      "description": "The minimum lifecycle state needed to select a local novel safely.",
      "enum": [
        "not_bootstrapped",
        "ready"
      ],
      "title": "ProjectStatus",
      "type": "string"
    }
  },
  "$id": "https://novel.local/schemas/project.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The small, stable manifest stored as ``novel.yaml``.",
  "properties": {
    "default_timeline_id": {
      "default": "main",
      "minLength": 1,
      "title": "Default Timeline Id",
      "type": "string"
    },
    "language": {
      "minLength": 2,
      "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$",
      "title": "Language",
      "type": "string"
    },
    "minimum_core_version": {
      "minLength": 1,
      "title": "Minimum Core Version",
      "type": "string"
    },
    "project_format_version": {
      "const": 1,
      "default": 1,
      "title": "Project Format Version",
      "type": "integer"
    },
    "project_id": {
      "format": "uuid",
      "title": "Project Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/ProjectStatus",
      "default": "not_bootstrapped"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "project_id",
    "title",
    "language",
    "minimum_core_version"
  ],
  "title": "ProjectManifest",
  "type": "object",
  "x-schema-version": "1.0.0"
}
