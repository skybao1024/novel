{
  "$defs": {
    "ReviewRecommendation": {
      "enum": [
        "revise",
        "ready"
      ],
      "title": "ReviewRecommendation",
      "type": "string"
    }
  },
  "$id": "https://novel.local/schemas/review.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "conclusion": {
      "minLength": 1,
      "title": "Conclusion",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "draft_revision": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Draft Revision",
      "type": "string"
    },
    "findings": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 64,
      "title": "Findings",
      "type": "array"
    },
    "recommendation": {
      "$ref": "#/$defs/ReviewRecommendation"
    },
    "retrieved_source_ids": {
      "default": [],
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Retrieved Source Ids",
      "type": "array"
    },
    "review_id": {
      "format": "uuid",
      "title": "Review Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "uncertainties": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 64,
      "title": "Uncertainties",
      "type": "array"
    },
    "writing_session_id": {
      "format": "uuid",
      "title": "Writing Session Id",
      "type": "string"
    }
  },
  "required": [
    "review_id",
    "writing_session_id",
    "draft_revision",
    "recommendation",
    "conclusion",
    "created_at"
  ],
  "title": "Review",
  "type": "object",
  "x-schema-version": "1.0.0"
}
