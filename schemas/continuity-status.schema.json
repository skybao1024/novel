{
  "$defs": {
    "ContinuityChapterStatus": {
      "additionalProperties": false,
      "properties": {
        "chapter_id": {
          "format": "uuid",
          "title": "Chapter Id",
          "type": "string"
        },
        "document_id": {
          "format": "uuid",
          "title": "Document Id",
          "type": "string"
        },
        "document_revision": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Document Revision",
          "type": "string"
        },
        "narrative_order": {
          "minimum": 1,
          "title": "Narrative Order",
          "type": "integer"
        },
        "retrieved_source_ids": {
          "default": [],
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Retrieved Source Ids",
          "type": "array"
        },
        "satisfied": {
          "title": "Satisfied",
          "type": "boolean"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "volume_id": {
          "format": "uuid",
          "title": "Volume Id",
          "type": "string"
        }
      },
      "required": [
        "volume_id",
        "chapter_id",
        "document_id",
        "document_revision",
        "narrative_order",
        "satisfied"
      ],
      "title": "ContinuityChapterStatus",
      "type": "object"
    }
  },
  "$id": "https://novel.local/schemas/continuity-status.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "continuity_volume_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Continuity Volume Id"
    },
    "missing_chapter_ids": {
      "default": [],
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Missing Chapter Ids",
      "type": "array"
    },
    "required_chapters": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ContinuityChapterStatus"
      },
      "title": "Required Chapters",
      "type": "array"
    },
    "revision_source_chapter_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Revision Source Chapter Id"
    },
    "revision_source_retrieved_source_ids": {
      "default": [],
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Revision Source Retrieved Source Ids",
      "type": "array"
    },
    "revision_source_satisfied": {
      "default": true,
      "title": "Revision Source Satisfied",
      "type": "boolean"
    },
    "satisfied": {
      "title": "Satisfied",
      "type": "boolean"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "writing_session_id": {
      "format": "uuid",
      "title": "Writing Session Id",
      "type": "string"
    }
  },
  "required": [
    "writing_session_id",
    "satisfied"
  ],
  "title": "ContinuityStatus",
  "type": "object",
  "x-schema-version": "1.0.0"
}
